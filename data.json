      "recommender": "Health Status includes input feature drift. If service metrics are normal but any feature is Warning, overall status remains Warning."
    },
    "drift": {
      "psi": [
        {
          "status": "Normal",
          "condition": "PSI < 0.10"
        },
        {
          "status": "Warning",
          "condition": "0.10 <= PSI <= 0.25"
        },
        {
          "status": "Critical",
          "condition": "PSI > 0.25"
        }
      ],
      "ks_p_value": [
        {
          "meaning": "No significant difference",
          "condition": "KS p-value >= 0.05"
        },
        {
          "meaning": "Significant difference",
          "condition": "KS p-value < 0.05"
        }
      ],
      "sort_order": [
        "Critical",
        "Warning",
        "Normal"
      ]
    },
    "formulas": {
      "forecast_skill_score": "1 - MAPE / Baseline MAPE",
      "forecast_alignment_rate": "Joined Rows / Prediction Count",
      "anomaly_rate": "Events / Valid Rows",
      "anomaly_coverage": "Valid Rows / Scored Rows",
      "recommender_success_rate": "Successful Runs / Total Runs",
      "recommender_adoption_rate": "Adopted Runs / Total Runs",
      "recommender_guardrail_rate": "Guardrail Blocked Runs / Total Runs"
    },
    "guardrail_blocked_runs": {
      "definition": "Guardrail Blocked Runs are successful completed runs with no output emitted.",
      "counting_rule": "Guardrail Blocked Runs are included in Successful Runs and excluded from Failed Runs. Successful Runs + Failed Runs = Total Runs."
    }
